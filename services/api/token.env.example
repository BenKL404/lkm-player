# ==========================================
# Configuration des Tokens et Variables d'Environnement
# Renommez ce fichier en "token.env" dans le même dossier.
# ==========================================

# Cookie ARL Deezer (Requis pour les téléchargements Deezer)
# Voir guide : https://github.com/nathom/streamrip/wiki/Finding-Your-Deezer-ARL-Cookie
DEEZER_TOKEN=your_deezer_arl_cookie_here

# Token du Bot Telegram (Requis uniquement pour faire fonctionner le bot)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Langue du bot (en, fr, etc.)
BOT_LANG=fr

# Activer la qualité FLAC si votre compte Deezer le permet (1 = Oui, 0 = Non/MP3)
ENABLE_FLAC=0

# Proxy pour Deezer (optionnel)
# DEEZER_PROXY=http://user:password@ip:port

# Limite du nombre de téléchargements simultanés sur l'API (défaut : 3)
MAX_CONCURRENT_DOWNLOADS=3

# Chemin vers un fichier de cookies YouTube (optionnel)
# COOKIES_PATH=/tmp/local_resources/cookies.txt

# Chemin vers les exécutables ffmpeg / ffprobe (optionnel, requis si non présents dans le PATH)
# FFMPEG_LOCATION=C:\ffmpeg\bin

# Clé d'authentification API REST (optionnel, sécurise l'accès si défini)
# API_KEY=votre_cle_api_secrete_ici


